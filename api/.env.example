# Copy this file to .env and fill in real values before running locally.
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional: enables real push notifications (Firebase Cloud Messaging).
# Download this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# Leave unset and everything else in the API still works fine, just without push.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Leave DB_DIALECT unset (or blank) to use local SQLite.
# Set DB_DIALECT=mssql plus the fields below to use Azure SQL in production.
# DB_DIALECT=mssql
# DB_HOST=your-server.database.windows.net
# DB_NAME=studyflow
# DB_USER=your-admin-user
# DB_PASS=your-admin-password
