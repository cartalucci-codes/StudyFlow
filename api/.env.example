# Copy this file to .env for local development. Never commit .env.
PORT=3000
JWT_SECRET=replace-with-a-long-random-string

# WEB OAuth client ID from Google Cloud Console (the same one used as default_web_client_id in the app)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ---- Database --------------------------------------------------------------------------
# Leave DB_DIALECT unset to use a local SQLite file (studyflow.sqlite).
# For Azure SQL (production) set these in the App Service "Environment variables":
# DB_DIALECT=mssql
# DB_HOST=your-server.database.windows.net
# DB_NAME=studyflow
# DB_USER=your-sql-admin-user
# DB_PASS=your-sql-admin-password

# ---- Push notifications (optional) ------------------------------------------------------
# Local: save the Firebase service account key as ./firebase-service-account.json (gitignored).
# Azure: set FIREBASE_SERVICE_ACCOUNT_BASE64 to the base64 of that JSON file.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=
